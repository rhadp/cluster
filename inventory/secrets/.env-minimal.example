# cloud provider and cluster shape
CLOUD_PROVIDER=aws
CLUSTER_TOPOLOGY=compact
CLUSTER_VERSION=4.22.17
CLUSTER_BASE_DOMAIN=sandboxXXXX.opentlc.com

# cluster configuration

#CLUSTER_ARM_NODES=true
#CLUSTER_BAREMETAL_NODES=false
#CLUSTER_VIRT=false

# cluster names

#RHAS_CLUSTER_NAME=rhas
#RHAS_PLATFORM_PREFIX=auto

# RHAS options

PLATFORM_DEPLOY_DEVSPACES=false # deploy dev spaces
PLATFORM_DEPLOY_JUMPSTARTER=false # deploy the jumpstarter operator
PLATFORM_DEPLOY_BUILDER=false # deploy the builder operator

# infrastructure credentials

PULL_SECRET_FILE=inventory/secrets/pull-secret.txt

AWS_ACCESS_KEY_ID=abc1234567890
AWS_SECRET_ACCESS_KEY=abc1234567890
AWS_REGION=eu-central-1

# GCP_SERVICE_ACCOUNT_KEY_FILE=
# GCP_SERVICE_ACCOUNT_EMAIL=
# GCP_PROJECT_ID=
# GCP_ORGANIZATION_ID=
# GCP_DEFAULT_REGION=

LETSENCRYPT_EMAIL=<your email>

# app credentials

#KEYCLOAK_DB_USER=admin
#KEYCLOAK_DB_PASSWORD=openshift
#KEYCLOAK_CLIENT_SECRET=openshiftkc

#DEFAULT_ADMIN_USER=admin
#DEFAULT_ADMIN_PASSWORD=openshift
#DEFAULT_ADMIN_EMAIL=admin@example.com

#DEFAULT_NOBODY_USER=nobody
#DEFAULT_NOBODY_PASSWORD=noone

# other config options

#INSTALLER_ARCHITECTURE=mac-arm64

